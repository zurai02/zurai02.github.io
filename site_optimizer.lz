// site_optimizer.lz - Website optimization pipeline
// Optimizes HTML, CSS, JS, images, and generates service worker + sitemap

import core
import math

// ============================================================================
// CONFIGURATION
// ============================================================================

pub struct Config {
    input_dir: string = "./dist",
    output_dir: string = "./optimized",
    image_quality: number = 85,
    enable_brotli: bool = true,
    enable_gzip: bool = true,
    minify_html: bool = true,
    minify_css: bool = true,
    minify_js: bool = true,
    inline_critical: bool = true,
    lazy_load: bool = true,
    cache_bust: bool = true,
    gen_sitemap: bool = true,
    gen_sw: bool = true,
    base_url: string = "https://example.com",
}

// ============================================================================
// STATS
// ============================================================================

pub struct Stats {
    files_processed: number = 0,
    original_bytes: number = 0,
    optimized_bytes: number = 0,
    errors: [string] = [],
    
    fn savings_percent(self) -> number {
        if self.original_bytes == 0 { return 0.0 }
        return ((self.original_bytes - self.optimized_bytes) / self.original_bytes) * 100.0
    }
    
    fn format_bytes(self, bytes: number) -> string {
        if bytes < 1024 { return format("{bytes} B") }
        if bytes < 1024 * 1024 { return format("{bytes / 1024:.1f} KB") }
        return format("{bytes / (1024 * 1024):.1f} MB")
    }
    
    fn print_report(self) -> nil {
        println("")
        println("=" * 50)
        println("OPTIMIZATION REPORT")
        println("=" * 50)
        println("Files processed: ", self.files_processed)
        println("Original size:   ", self.format_bytes(self.original_bytes))
        println("Optimized size:  ", self.format_bytes(self.optimized_bytes))
        println("Space saved:     ", self.format_bytes(self.original_bytes - self.optimized_bytes), 
                " (", self.savings_percent(), "%)")
        
        if len(self.errors) > 0 {
            println("\nErrors (", len(self.errors), "):")
            for err in self.errors {
                println("  - ", err)
            }
        }
        
        println("\nOptimization complete!")
    }
}

// ============================================================================
// HTML MINIFIER
// ============================================================================

pub struct HtmlMinifier {
    config: Config,
}

impl HtmlMinifier {
    fn can_process(self, file_path: string) -> bool {
        return path.ext(file_path) == ".html"
    }
    
    fn process(self, content: string) -> Result<string, string> {
        if !self.config.minify_html {
            return Result.Ok(content)
        }
        
        let result = content
        
        // Remove HTML comments (preserve IE conditionals)
        result = string.replace(result, "<!--(?!<!\\[endif\\]|\\[if)[\\s\\S]*?-->", "")
        
        // Collapse whitespace between tags
        result = string.replace(result, ">\\s+<", "><")
        
        // Remove unnecessary type attributes
        result = string.replace(result, " type=\"text/javascript\"", "")
        result = string.replace(result, " type=\"text/css\"", "")
        
        // Collapse multiple spaces
        result = string.replace(result, "\\s{2,}", " ")
        
        // Add lazy loading to images
        if self.config.lazy_load {
            result = self.add_lazy_loading(result)
        }
        
        // Inline critical CSS
        if self.config.inline_critical {
            result = self.inline_critical_css(result)
        }
        
        // Add preconnect hints for external domains
        result = self.add_preconnect_hints(result)
        
        // Ensure viewport meta
        result = self.ensure_viewport(result)
        
        // Register service worker
        if self.config.gen_sw {
            result = self.add_sw_registration(result)
        }
        
        return Result.Ok(string.trim(result))
    }
    
    fn add_lazy_loading(self, html: string) -> string {
        let result = html
        let images = string.match_all(result, "<img[^>]*>")
        
        for i, img in images {
            if i == 0 { continue } // Skip first image (likely hero)
            if !string.contains(img, "loading=") {
                let lazy_img = string.replace(img, "<img", "<img loading=\"lazy\" decoding=\"async\"")
                result = string.replace(result, img, lazy_img)
            }
        }
        
        return result
    }
    
    fn inline_critical_css(self, html: string) -> string {
        let critical = ""
        let styles = string.match_all(html, "<style[^>]*>([\\s\\S]*?)</style>")
        
        for style_match in styles {
            critical = critical + style_match[1] + "\n"
        }
        
        if len(critical) == 0 { return html }
        
        // Minify critical CSS
        critical = self.minify_css_inline(critical)
        
        // Inline it
        let inlined = string.replace(html, "</head>", 
            "<style>" + critical + "</style></head>")
        
        // Convert external CSS to async load
        let links = string.match_all(inlined, 
            "<link[^>]*rel=\"stylesheet\"[^>]*href=\"([^\"]*)\"[^>]*>")
        
        for link_match in links {
            let href = link_match[1]
            let preload = format(
                "<link rel=\"preload\" href=\"{href}\" as=\"style\" onload=\"this.rel='stylesheet'\">" +
                "<noscript><link rel=\"stylesheet\" href=\"{href}\"></noscript>"
            )
            inlined = string.replace(inlined, link_match[0], preload)
        }
        
        return inlined
    }
    
    fn minify_css_inline(self, css: string) -> string {
        let result = string.replace(css, "/\\*[\\s\\S]*?\\*/", "")
        result = string.replace(result, "\\s*{\\s*", "{")
        result = string.replace(result, "\\s*}\\s*", "}")
        result = string.replace(result, "\\s*;\\s*", ";")
        result = string.replace(result, "\\s*:\\s*", ":")
        result = string.replace(result, ";}", "}")
        return string.trim(result)
    }
    
    fn add_preconnect_hints(self, html: string) -> string {
        let domains = self.extract_external_domains(html)
        let hints = ""
        
        for domain in domains {
            if !string.contains(html, "preconnect\"" + domain) {
                hints = hints + format("<link rel=\"preconnect\" href=\"{domain}\">\n")
                hints = hints + format("<link rel=\"dns-prefetch\" href=\"{domain}\">\n")
            }
        }
        
        if len(hints) > 0 {
            return string.replace(html, "<head>", "<head>\n" + hints)
        }
        
        return html
    }
    
    fn extract_external_domains(self, html: string) -> [string] {
        let domains = []
        let matches = string.match_all(html, "https?://([^/\"]+)")
        
        for m in matches {
            let domain = "https://" + m[1]
            if !array.contains(domains, domain) && 
               !string.contains(domain, "localhost") &&
               !string.contains(domain, "127.0.0.1") {
                domains.push(domain)
            }
        }
        
        return domains
    }
    
    fn ensure_viewport(self, html: string) -> string {
        if !string.contains(html, "viewport") {
            return string.replace(html, "<head>", 
                "<head><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">")
        }
        return html
    }
    
    fn add_sw_registration(self, html: string) -> string {
        if string.contains(html, "serviceWorker") { return html }
        
        let script = `
<script>
if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
}
</script>`
        
        return string.replace(html, "</body>", script + "\n</body>")
    }
}

// ============================================================================
// CSS MINIFIER
// ============================================================================

pub struct CssMinifier {
    config: Config,
}

impl CssMinifier {
    fn can_process(self, file_path: string) -> bool {
        return path.ext(file_path) == ".css"
    }
    
    fn process(self, content: string) -> Result<string, string> {
        if !self.config.minify_css {
            return Result.Ok(content)
        }
        
        let result = content
        
        // Remove comments
        result = string.replace(result, "/\\*[\\s\\S]*?\\*/", "")
        
        // Remove whitespace
        result = string.replace(result, "\\s*{\\s*", "{")
        result = string.replace(result, "\\s*}\\s*", "}")
        result = string.replace(result, "\\s*;\\s*", ";")
        result = string.replace(result, "\\s*:\\s*", ":")
        result = string.replace(result, "\\s*,\\s*", ",")
        
        // Remove last semicolon in blocks
        result = string.replace(result, ";}", "}")
        
        // Collapse zero values
        result = string.replace(result, " 0px", " 0")
        result = string.replace(result, " 0em", " 0")
        result = string.replace(result, " 0rem", " 0")
        result = string.replace(result, " 0%", " 0")
        
        return Result.Ok(string.trim(result))
    }
}

// ============================================================================
// JS MINIFIER
// ============================================================================

pub struct JsMinifier {
    config: Config,
}

impl JsMinifier {
    fn can_process(self, file_path: string) -> bool {
        return path.ext(file_path) == ".js"
    }
    
    fn process(self, content: string) -> Result<string, string> {
        if !self.config.minify_js {
            return Result.Ok(content)
        }
        
        let result = content
        
        // Remove single-line comments
        result = string.replace(result, "//[^\\n]*", "")
        
        // Remove multi-line comments
        result = string.replace(result, "/\\*[\\s\\S]*?\\*/", "")
        
        // Collapse whitespace (conservative)
        result = string.replace(result, "\\n\\s*\\n", "\n")
        
        return Result.Ok(string.trim(result))
    }
}

// ============================================================================
// IMAGE OPTIMIZER
// ============================================================================

pub struct ImageOptimizer {
    config: Config,
}

impl ImageOptimizer {
    fn can_process(self, file_path: string) -> bool {
        let ext = path.ext(file_path)
        return ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif"
    }
    
    async fn optimize(self, file_path: string, output_dir: string) -> Result<[string], string> {
        let results = []
        let ext = path.ext(file_path)
        let basename = path.basename(file_path, ext)
        let out_dir = path.join(output_dir, path.relative(self.config.input_dir, path.dirname(file_path)))
        
        fs.ensure_dir(out_dir)
        
        // Copy original
        let out_path = path.join(out_dir, path.basename(file_path))
        fs.copy(file_path, out_path)
        results.push(out_path)
        
        // Generate WebP
        let webp_path = path.join(out_dir, basename + ".webp")
        let cmd = format("cwebp -q {self.config.image_quality} \"{file_path}\" -o \"{webp_path}\"")
        let exec_result = await process.exec_async(cmd)
        
        if exec_result.code == 0 {
            results.push(webp_path)
        }
        
        // Generate AVIF
        let avif_path = path.join(out_dir, basename + ".avif")
        let avif_cmd = format("avifenc --min 0 --max 63 -a end-usage=q -a cq-level=20 \"{file_path}\" \"{avif_path}\"")
        let avif_result = await process.exec_async(avif_cmd)
        
        if avif_result.code == 0 {
            results.push(avif_path)
        }
        
        return Result.Ok(results)
    }
}

// ============================================================================
// COMPRESSION
// ============================================================================

pub struct CompressionGenerator {
    config: Config,
}

impl CompressionGenerator {
    async fn generate(self, file_path: string) -> Result<nil, string> {
        let content = fs.read_bytes(file_path)
        
        if self.config.enable_gzip {
            let gzipped = crypto.gzip(content, 9)
            fs.write_bytes(file_path + ".gz", gzipped)
        }
        
        if self.config.enable_brotli {
            let brotlied = crypto.brotli(content, 11)
            fs.write_bytes(file_path + ".br", brotlied)
        }
        
        return Result.Ok(nil)
    }
}

// ============================================================================
// CACHE BUSTING
// ============================================================================

pub struct CacheBuster {
    config: Config,
}

impl CacheBuster {
    fn apply(self, output_dir: string) -> Result<nil, string> {
        let assets = fs.glob(output_dir + "/**/*.{css,js}")
        let hash_map: Map<string, string> = Map.new()
        
        // Rename with content hash
        for file in assets {
            let content = fs.read(file)
            let hash = crypto.sha256(content)
            let short_hash = string.sub(hash, 1, 8)
            let ext = path.ext(file)
            let basename = path.basename(file, ext)
            let dir = path.dirname(file)
            let new_name = format("{basename}.{short_hash}{ext}")
            let new_path = path.join(dir, new_name)
            
            fs.move(file, new_path)
            hash_map.set(file, new_path)
        }
        
        // Update references in HTML
        let html_files = fs.glob(output_dir + "/**/*.html")
        for file in html_files {
            let content = fs.read(file)
            let new_content = content
            
            for old_path, new_path in hash_map {
                let rel_old = path.relative(output_dir, old_path)
                let rel_new = path.relative(output_dir, new_path)
                new_content = string.replace(new_content, rel_old, rel_new)
            }
            
            fs.write(file, new_content)
        }
        
        return Result.Ok(nil)
    }
}

// ============================================================================
// SERVICE WORKER
// ============================================================================

pub struct ServiceWorkerGenerator {
    config: Config,
}

impl ServiceWorkerGenerator {
    fn generate(self, output_dir: string) -> nil {
        let files = fs.walk(output_dir)
        let cache_files = []
        
        for file in files {
            let rel = path.relative(output_dir, file)
            if string.starts_with(rel, ".") { continue }
            if string.ends_with(rel, ".map") { continue }
            if string.ends_with(rel, ".gz") { continue }
            if string.ends_with(rel, ".br") { continue }
            cache_files.push("/" + rel)
        }
        
        let sw_content = format(`
const CACHE_NAME = 'site-v1-{math.floor(time.now() / 1000)}';
const urlsToCache = {json.encode(cache_files)};

self.addEventListener('install', e => {
    e.waitUntil(caches.open(CACHE_NAME).then(c => c.addAll(urlsToCache)));
    self.skipWaiting();
});

self.addEventListener('fetch', e => {
    e.respondWith(
        caches.match(e.request).then(r => {
            if (r) return r;
            return fetch(e.request).then(response => {
                if (!response || response.status !== 200 || response.type !== 'basic') {
                    return response;
                }
                const clone = response.clone();
                caches.open(CACHE_NAME).then(c => c.put(e.request, clone));
                return response;
            });
        })
    );
});

self.addEventListener('activate', e => {
    e.waitUntil(
        caches.keys().then(names => Promise.all(
            names.filter(n => n !== CACHE_NAME).map(n => caches.delete(n))
        ))
    );
    self.clients.claim();
});
`)
        
        fs.write(path.join(output_dir, "sw.js"), string.trim(sw_content))
    }
}

// ============================================================================
// SITEMAP
// ============================================================================

pub struct SitemapGenerator {
    config: Config,
}

impl SitemapGenerator {
    fn generate(self, output_dir: string) -> nil {
        let html_files = fs.glob(output_dir + "/**/*.html")
        let entries = []
        
        for file in html_files {
            let rel = path.relative(output_dir, file)
            let url_path = string.replace(rel, "index.html", "")
            let url = self.config.base_url + "/" + url_path
            let stat = fs.stat(file)
            
            entries.push({
                loc: url,
                lastmod: stat.mtime,
                priority: rel == "index.html" ? "1.0" : "0.8",
            })
        }
        
        let xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
        xml = xml + "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n"
        
        for entry in entries {
            xml = xml + "  <url>\n"
            xml = xml + "    <loc>" + entry.loc + "</loc>\n"
            xml = xml + "    <lastmod>" + entry.lastmod + "</lastmod>\n"
            xml = xml + "    <priority>" + entry.priority + "</priority>\n"
            xml = xml + "  </url>\n"
        }
        
        xml = xml + "</urlset>"
        
        fs.write(path.join(output_dir, "sitemap.xml"), xml)
        
        // robots.txt
        let robots = format("User-agent: *\nAllow: /\nSitemap: {self.config.base_url}/sitemap.xml")
        fs.write(path.join(output_dir, "robots.txt"), robots)
    }
}

// ============================================================================
// MAIN OPTIMIZER
// ============================================================================

pub struct Optimizer {
    config: Config,
    stats: Stats,
    html_minifier: HtmlMinifier,
    css_minifier: CssMinifier,
    js_minifier: JsMinifier,
    image_optimizer: ImageOptimizer,
    compression: CompressionGenerator,
    cache_buster: CacheBuster,
    sw_gen: ServiceWorkerGenerator,
    sitemap_gen: SitemapGenerator,
}

impl Optimizer {
    fn new(config: Config) -> Optimizer {
        return Optimizer {
            config: config,
            stats: Stats {},
            html_minifier: HtmlMinifier { config: config },
            css_minifier: CssMinifier { config: config },
            js_minifier: JsMinifier { config: config },
            image_optimizer: ImageOptimizer { config: config },
            compression: CompressionGenerator { config: config },
            cache_buster: CacheBuster { config: config },
            sw_gen: ServiceWorkerGenerator { config: config },
            sitemap_gen: SitemapGenerator { config: config },
        }
    }
    
    async fn run(self) -> nil {
        println("Starting site optimization...")
        println("Input:  ", self.config.input_dir)
        println("Output: ", self.config.output_dir)
        
        fs.ensure_dir(self.config.output_dir)
        
        // Phase 1: Process files
        await self.process_files()
        
        // Phase 2: Optimize images
        await self.process_images()
        
        // Phase 3: Generate compression
        await self.generate_compression()
        
        // Phase 4: Cache busting
        if self.config.cache_bust {
            println("\nApplying cache busting...")
            match self.cache_buster.apply(self.config.output_dir) {
                Result.Ok(_) => println("  Cache busting applied"),
                Result.Err(e) => self.stats.errors.push(e),
            }
        }
        
        // Phase 5: Service worker
        if self.config.gen_sw {
            println("\nGenerating service worker...")
            self.sw_gen.generate(self.config.output_dir)
            println("  Service worker generated")
        }
        
        // Phase 6: Sitemap
        if self.config.gen_sitemap {
            println("\nGenerating sitemap...")
            self.sitemap_gen.generate(self.config.output_dir)
            println("  Sitemap and robots.txt generated")
        }
        
        // Report
        self.stats.print_report()
    }
    
    async fn process_files(self) -> nil {
        println("\nProcessing files...")
        
        let files = fs.walk(self.config.input_dir)
        let tasks = []
        
        for file in files {
            let rel = path.relative(self.config.input_dir, file)
            let out_path = path.join(self.config.output_dir, rel)
            fs.ensure_dir(path.dirname(out_path))
            
            // Skip images (handled separately)
            if self.image_optimizer.can_process(file) {
                continue
            }
            
            tasks.push(self.process_single_file(file, out_path))
        }
        
        for task in tasks {
            await task
        }
        
        println("  Processed ", self.stats.files_processed, " files")
    }
    
    async fn process_single_file(self, input: string, output: string) -> nil {
        let content = fs.read(input)
        let original_size = #content
        let result = content
        
        // Try HTML minifier
        if self.html_minifier.can_process(input) {
            match self.html_minifier.process(result) {
                Result.Ok(processed) => { result = processed },
                Result.Err(e) => self.stats.errors.push(e),
            }
        }
        
        // Try CSS minifier
        if self.css_minifier.can_process(input) {
            match self.css_minifier.process(result) {
                Result.Ok(processed) => { result = processed },
                Result.Err(e) => self.stats.errors.push(e),
            }
        }
        
        // Try JS minifier
        if self.js_minifier.can_process(input) {
            match self.js_minifier.process(result) {
                Result.Ok(processed) => { result = processed },
                Result.Err(e) => self.stats.errors.push(e),
            }
        }
        
        fs.write(output, result)
        
        self.stats.original_bytes += original_size
        self.stats.optimized_bytes += #result
        self.stats.files_processed += 1
    }
    
    async fn process_images(self) -> nil {
        println("\nOptimizing images...")
        
        let images = fs.glob(self.config.input_dir + "/**/*.{jpg,jpeg,png,gif}")
        let tasks = []
        
        for img in images {
            tasks.push(self.image_optimizer.optimize(img, self.config.output_dir))
        }
        
        let total_variants = 0
        for task in tasks {
            match await task {
                Result.Ok(variants) => { total_variants += len(variants) },
                Result.Err(e) => self.stats.errors.push(e),
            }
        }
        
        println("  Generated ", total_variants, " image variants")
    }
    
    async fn generate_compression(self) -> nil {
        if !self.config.enable_gzip && !self.config.enable_brotli {
            return
        }
        
        println("\nGenerating compression files...")
        
        let assets = fs.glob(self.config.output_dir + "/**/*.{html,css,js,svg,json}")
        let tasks = []
        
        for asset in assets {
            tasks.push(self.compression.generate(asset))
        }
        
        for task in tasks {
            await task
        }
        
        println("  Compressed ", len(assets), " assets")
    }
}

// ============================================================================
// CLI
// ============================================================================

fn parse_args(args: [string]) -> Config {
    let config = Config {}
    let i = 1
    
    while i < len(args) {
        let arg = args[i]
        
        match arg {
            "-i" | "--input" => {
                i = i + 1
                config.input_dir = args[i]
            },
            "-o" | "--output" => {
                i = i + 1
                config.output_dir = args[i]
            },
            "-q" | "--quality" => {
                i = i + 1
                config.image_quality = number.parse(args[i])
            },
            "-u" | "--url" => {
                i = i + 1
                config.base_url = args[i]
            },
            "--no-brotli" => config.enable_brotli = false,
            "--no-gzip" => config.enable_gzip = false,
            "--no-minify" => {
                config.minify_html = false
                config.minify_css = false
                config.minify_js = false
            },
            "--no-lazy" => config.lazy_load = false,
            "--no-critical" => config.inline_critical = false,
            "--no-cache-bust" => config.cache_bust = false,
            "--no-sitemap" => config.gen_sitemap = false,
            "--no-sw" => config.gen_sw = false,
            "-h" | "--help" => {
                println("Site Optimizer - Optimize your website for production")
                println("")
                println("Usage: lz run site_optimizer.lz [options]")
                println("")
                println("Options:")
                println("  -i, --input <dir>     Input directory (default: ./dist)")
                println("  -o, --output <dir>    Output directory (default: ./optimized)")
                println("  -q, --quality <n>     Image quality 1-100 (default: 85)")
                println("  -u, --url <url>       Base URL for sitemap")
                println("  --no-brotli           Disable Brotli compression")
                println("  --no-gzip             Disable Gzip compression")
                println("  --no-minify           Disable all minification")
                println("  --no-lazy             Disable lazy loading")
                println("  --no-critical         Disable critical CSS inlining")
                println("  --no-cache-bust       Disable cache busting")
                println("  --no-sitemap          Disable sitemap generation")
                println("  --no-sw               Disable service worker")
                println("  -h, --help            Show this help")
                process.exit(0)
            },
            _ => {},
        }
        
        i = i + 1
    }
    
    return config
}

// ============================================================================
// MAIN
// ============================================================================

async fn main() -> nil {
    let config = parse_args(process.args)
    let optimizer = Optimizer.new(config)
    await optimizer.run()
}

main()
